// Passaporte do Leitor - Database Schema
// Using Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum LevelCategory {
  MAGIC
  EXPLORERS
  KNIGHTS
  SPACE
}

enum Genre {
  ADVENTURE @map("adventure")
  FANTASY   @map("fantasy")
  MYSTERY   @map("mystery")
  SCIENCE   @map("science")
  COMICS    @map("comics")
  ROMANCE   @map("romance")
  HORROR    @map("horror")
  BIOGRAPHY @map("biography")
  POETRY    @map("poetry")
  HISTORY   @map("history")
  ANIMALS   @map("animals")
  HUMOR     @map("humor")
}

enum BookStatus {
  TO_READ  @map("to-read")
  READING  @map("reading")
  FINISHED @map("finished")
}

// ============================================================================
// MODELOS PRINCIPAIS
// ============================================================================

model Family {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  password  String? // Hashed, opcional para MVP
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children Child[]
  books    Book[]
  settings FamilySettings?

  @@map("families")
}

model FamilySettings {
  id       String @id @default(cuid())
  familyId String @unique
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  // Preferências
  language      String  @default("pt-PT")
  notifications Boolean @default(true)
  weeklyReport  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("family_settings")
}

model Child {
  id            String        @id @default(cuid())
  familyId      String
  name          String
  avatar        String        @default("👦")
  birthYear     Int?
  levelCategory LevelCategory @default(EXPLORERS)
  dailyGoal     Int           @default(15) // Daily reading goal in minutes
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  family          Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childBooks      ChildBook[]
  readingSessions ReadingSession[]
  achievements    ChildAchievement[]

  @@index([familyId])
  @@map("children")
}

// Metadados partilhados do livro (âmbito família).
// Vários filhos da mesma família podem partilhar o mesmo Book,
// cada um com o seu próprio estado de leitura em ChildBook.
model Book {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  // Informação do livro
  title      String
  author     String
  isbn       String?
  genre      Genre
  totalPages Int?

  // Datas de registo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  childBooks      ChildBook[]
  readingSessions ReadingSession[]

  @@index([familyId])
  @@index([genre])
  @@map("books")
}

// Estado de leitura por-criança de um Book.
model ChildBook {
  id      String @id @default(cuid())
  bookId  String
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  // Estado de Leitura
  status      BookStatus @default(TO_READ)
  currentPage Int?
  startDate   DateTime?
  finishDate  DateTime?

  // Avaliação
  rating            Int? // 1-5
  notes             String? // "O que achou"
  favoriteCharacter String?

  // Datas de registo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([childId, bookId])
  @@index([childId])
  @@index([childId, status])
  @@map("child_books")
}

model Achievement {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String
  description String
  icon        String
  category    AchievementCategory @default(READING)

  // Requisitos (JSON para flexibilidade)
  requirements Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  childAchievements ChildAchievement[]

  @@map("achievements")
}

model ChildAchievement {
  id            String      @id @default(cuid())
  childId       String
  child         Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  earnedAt DateTime @default(now())

  @@unique([childId, achievementId])
  @@map("child_achievements")
}

enum AchievementCategory {
  READING // Relacionado com quantidade de leitura
  GENRE // Relacionado com géneros
  STREAK // Relacionado com consistência
  SPECIAL // Conquistas especiais
}

// ============================================================================
// ADMINISTRAÇÃO ESCOLAR
// ============================================================================

// Conta de administrador escolar (separada das famílias).
// Criada manualmente (ver scripts/create-school-admin.ts).
// O âmbito do admin (agrupamento/concelho) NÃO é guardado aqui — deriva-se das
// escolas a que está ligado via SchoolAdminEscola -> Escola.
model SchoolAdmin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // Hashed (bcrypt, 10 rounds)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escolas SchoolAdminEscola[]

  @@map("school_admins")
}

// Escola: concelho + agrupamento + nome (modelo híbrido pragmático).
model Escola {
  id          String   @id @default(cuid())
  concelho    String
  agrupamento String
  nome        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  turmas Turma[]
  admins SchoolAdminEscola[]

  @@index([agrupamento])
  @@map("escolas")
}

// Relação N:N admin <-> escola (um admin pode gerir várias escolas).
model SchoolAdminEscola {
  id            String   @id @default(cuid())
  schoolAdminId String   @map("school_admin_id")
  escolaId      String   @map("escola_id")
  createdAt     DateTime @default(now())

  schoolAdmin SchoolAdmin @relation(fields: [schoolAdminId], references: [id], onDelete: Cascade)
  escola      Escola      @relation(fields: [escolaId], references: [id], onDelete: Cascade)

  @@unique([schoolAdminId, escolaId])
  @@index([escolaId])
  @@map("school_admin_escolas")
}

// Turma de uma escola, com o professor responsável e o seu email.
model Turma {
  id        String   @id @default(cuid())
  escolaId  String   @map("escola_id")
  nome      String // Ex: "3.º A"
  professor String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escola Escola @relation(fields: [escolaId], references: [id], onDelete: Cascade)

  @@index([escolaId])
  @@map("turmas")
}

// ============================================================================
// ÍNDICES ADICIONAIS PARA PERFORMANCE
// ============================================================================

// Os índices principais já estão definidos acima com @@index

model ReadingSession {
  id      String @id @default(cuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  // Dados da sessão
  date    DateTime @default(now()) // Dia da sessão
  minutes Int // Duração em minutos (obrigatório)

  // Livro (obrigatório)
  bookId String
  book   Book   @relation(fields: [bookId], references: [id])

  // Progresso (opcional)
  pageEnd Int? // Página onde terminou

  // Feedback (opcional)
  mood Int? @default(3) // 1-5 (😫 a 🤩)

  // Terminou o livro nesta sessão?
  finishedBook Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([childId])
  @@index([childId, date])
  @@index([bookId])
  @@map("reading_sessions")
}
